#!/usr/bin/env bash
# ============================================================================
# venv-style activation for the Sprkey dev environment (pm-managed tools).
#
#   source ./activate      (bash / zsh, repo root)
#   .\activate.ps1         (PowerShell)
#
# Emits the composed pm env (PATH + tool vars) into the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `sprkey` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `sprkey pm
# install` and `sprkey update` keep that check.
# ============================================================================
_SPRKEY_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_sprkey_test_env="--test-environment"
_sprkey_expect_extras=""
for _sprkey_arg in "$@"; do
    if [ -n "$_sprkey_expect_extras" ]; then
        _sprkey_test_env="--test-environment=$_sprkey_arg"
        _sprkey_expect_extras=""
        continue
    fi
    case "$_sprkey_arg" in
        --) break ;;
        --test-extras) _sprkey_expect_extras=1 ;;
        --test-extras=*) _sprkey_test_env="--test-environment=${_sprkey_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_sprkey_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _sprkey_arg _sprkey_test_env _sprkey_expect_extras
    return 2 2>/dev/null || exit 2
fi
# Setup runs in a child: failures must not exit or partially activate the
# caller's shell, and activation must not republish launchers or shell config.
if ! (
    unset PYTHONHOME PYTHONPATH VIRTUAL_ENV
    bash "$_SPRKEY_REPO/setup-sprkey.sh" --runtime-only "$_sprkey_test_env"
) >&2; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _sprkey_arg _sprkey_test_env _sprkey_expect_extras
    return 1 2>/dev/null || exit 1
fi
unset _sprkey_arg _sprkey_test_env _sprkey_expect_extras

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __SPRKEY_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

# Bootstrap Python only emits the environment; it does not install anything.
_sprkey_repo="$_SPRKEY_REPO"
_sprkey_py=""
for _sprkey_candidate in "$_sprkey_repo/.venv/bin/python" "$_sprkey_repo/.venv/Scripts/python.exe" \
                         "$_sprkey_repo/venv/bin/python" "$_sprkey_repo/venv/Scripts/python.exe"; do
    [ -x "$_sprkey_candidate" ] && { _sprkey_py="$_sprkey_candidate"; break; }
done
if [ -z "$_sprkey_py" ]; then
    for _sprkey_store in "${SPRKEY_RUNTIME_DIR:-}" "$_sprkey_repo/../tools" "${SPRKEY_HOME:-$HOME/.sprkey}/tools"; do
        [ -n "$_sprkey_store" ] || continue
        for _sprkey_candidate in "$_sprkey_store"/python-*/bin/python3 "$_sprkey_store"/python-*/python.exe "$_sprkey_store"/python-*/bin/python "$_sprkey_store"/python-*/bin/python.exe; do
            [ -x "$_sprkey_candidate" ] && { _sprkey_py="$_sprkey_candidate"; break; }
        done
        [ -n "$_sprkey_py" ] && break
    done
fi
if [ -z "$_sprkey_py" ]; then
    echo "activate: no bootstrap Python found; run setup-sprkey.sh" >&2
    return 1 2>/dev/null || exit 1
fi

# --- emit export lines from `pm env` ---
_sprkey_json="$(PYTHONHOME= PYTHONPATH="$_sprkey_repo" "$_sprkey_py" -m pm.environments)"
if [ -z "$_sprkey_json" ] || [ "${_sprkey_json#*{}" = "$_sprkey_json" ]; then
    echo "activate: could not read pm env (run ./setup-sprkey.sh first)" >&2
    unset _sprkey_repo _sprkey_os _sprkey_arch _sprkey_target _sprkey_store _sprkey_py _sprkey_json
    return 1 2>/dev/null || exit 1
fi

_sprkey_keys="$(printf '%s' "$_sprkey_json" | "$_sprkey_py" -c 'import json,sys; print(" ".join(json.load(sys.stdin)))' \
    | tr ' ' '\n' | grep -E '^[A-Za-z_][A-Za-z0-9_]*$' | tr '\n' ' ')"
[ -n "$_sprkey_keys" ] || _sprkey_keys="PATH"

# --- snapshot what we are about to change (deactivate restores this) ---
# __SPRKEY_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__SPRKEY_SAVED_PATH="$PATH"
for _sprkey_k in $_sprkey_keys; do
    eval "__SPRKEY_SAVED_$_sprkey_k=\"\${$_sprkey_k+set}\""
    eval "__SPRKEY_PRIOR_$_sprkey_k=\${$_sprkey_k-__SPRKEY_UNSET__}"
done

# Resolved before the export below replaces PATH.
_sprkey_cygpath="$(command -v cygpath 2>/dev/null || :)"

eval "$(printf '%s' "$_sprkey_json" | "$_sprkey_py" -c '
import json, sys, shlex, re
for k, v in json.load(sys.stdin).items():
    # Windows carries names like ProgramFiles(ARM) that are not valid
    # bash identifiers — skip them (they pass through untouched).
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k):
        continue
    print("export %s=%s" % (k, shlex.quote(str(v))))')"

# The MSYS/Cygwin runtime hands a native Windows Python these variables in
# Windows form (`C:\a;C:\b`) and converts them back only for its own children.
# Exported verbatim, bash splits PATH on ':' and finds no commands.
if [ -n "$_sprkey_cygpath" ]; then
    PATH="$("$_sprkey_cygpath" -u -p "$PATH")"
    for _sprkey_k in HOME TMPDIR TMP TEMP; do
        if [ -n "${!_sprkey_k-}" ]; then
            printf -v "$_sprkey_k" '%s' "$("$_sprkey_cygpath" -u "${!_sprkey_k}")"
        fi
    done
fi

# This checkout, not whichever `sprkey` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__SPRKEY_WORKTREE="$_sprkey_repo"
# The branch names the worktree. A checkout cannot share a branch with another.
__SPRKEY_WORKTREE_NAME="$(git -C "$_sprkey_repo" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__SPRKEY_WORKTREE_NAME" ] || [ "$__SPRKEY_WORKTREE_NAME" = HEAD ]; then
    __SPRKEY_WORKTREE_NAME="$(basename "$_sprkey_repo")"
fi
__SPRKEY_SAVED_PS1="${PS1-__SPRKEY_UNSET__}"
__SPRKEY_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__SPRKEY_UNSET__}"

_sprkey_worktree_here() {
    _sprkey_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_sprkey_top" && pwd -P)" = "$(cd "$__SPRKEY_WORKTREE" && pwd -P)" ]
}

sprkey() {
    _sprkey_worktree_here || {
        printf '%s\n' "sprkey: $(pwd) is outside $__SPRKEY_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__SPRKEY_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" sprkey "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe sprkey "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python sprkey "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe sprkey "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python sprkey "$@"
        else
            exec python sprkey "$@"
        fi
    )
}

_sprkey_prompt() {
    if [ "$__SPRKEY_SAVED_PS1" = "__SPRKEY_UNSET__" ]; then
        _sprkey_base_ps1=""
    else
        _sprkey_base_ps1="$__SPRKEY_SAVED_PS1"
    fi
    if _sprkey_worktree_here; then
        PS1="($__SPRKEY_WORKTREE_NAME) $_sprkey_base_ps1"
    else
        PS1="$_sprkey_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_sprkey_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_sprkey_prompt
fi
_sprkey_prompt

deactivate() {
    export PATH="$__SPRKEY_SAVED_PATH"
    for _sprkey_k in $__SPRKEY_KEY_LIST; do
        eval "_sprkey_was=\"\$__SPRKEY_SAVED_$_sprkey_k\""
        eval "_sprkey_old=\"\$__SPRKEY_PRIOR_$_sprkey_k\""
        if [ "$_sprkey_was" != "set" ]; then
            unset "$_sprkey_k"
        else
            export "$_sprkey_k=$_sprkey_old"
        fi
        unset "__SPRKEY_SAVED_$_sprkey_k" "__SPRKEY_PRIOR_$_sprkey_k"
    done
    if [ "$__SPRKEY_SAVED_PS1" = "__SPRKEY_UNSET__" ]; then
        unset PS1
    else
        PS1="$__SPRKEY_SAVED_PS1"
    fi
    if [ "$__SPRKEY_SAVED_PROMPT_COMMAND" = "__SPRKEY_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__SPRKEY_SAVED_PROMPT_COMMAND"
    fi
    unset __SPRKEY_SAVED_PATH __SPRKEY_KEY_LIST __SPRKEY_ACTIVATED \
          __SPRKEY_WORKTREE __SPRKEY_WORKTREE_NAME \
          __SPRKEY_SAVED_PS1 __SPRKEY_SAVED_PROMPT_COMMAND
    unset -f deactivate sprkey _sprkey_worktree_here _sprkey_prompt
    unset _sprkey_k _sprkey_was _sprkey_old _sprkey_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__SPRKEY_KEY_LIST="$_sprkey_keys"

unset _sprkey_repo _sprkey_os _sprkey_arch _sprkey_target _sprkey_store \
      _sprkey_py _sprkey_json _sprkey_keys _sprkey_k _sprkey_entry _sprkey_venvpy \
      _sprkey_winarch _sprkey_top _sprkey_cygpath
